{
  "name": "nexus-game-hub",
  "version": "1.0.0",
  "description": "NEXUS Game Hub — unified game launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "deploy": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.vivre.nexusgamehub",
    "productName": "NEXUS Game Hub",
    "files": ["**/*"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Jzhehdjebe",
      "repo": "nexus-game-hub"
    }
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}